# MongoDB
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=myanmar_job_market

# Responsible collection settings
REQUEST_DELAY_SECONDS=3
MAX_LISTING_PAGES=200
SYNC_INTERVAL_MINUTES=180
REFRESH_AFTER_HOURS=24
INACTIVE_AFTER_DAYS=3
SCRAPER_USER_AGENT=MyanmarJobMarketResearch/1.0 (educational project; contact site owner before collection)
